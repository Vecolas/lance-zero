{
  "name": "lance-zero",
  "version": "0.1.0",
  "private": true,
  "description": "LanceZero — treine o que perde suas partidas.",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "security:check": "node scripts/security/check-public-env.mjs && node scripts/security/check-rls.mjs && vitest run security-",
    "test:e2e:prod": "node scripts/e2e/prod.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "chess.js": "1.4.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-chessboard": "5.12.1",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "ts-fsrs": "5.4.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
